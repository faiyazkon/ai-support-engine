# Copy this file to .env and fill in the values. Never commit .env.
# A long random secret that every caller (e.g. your Telegram bot) must send in the X-API-Key header.
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Largest request body the server will accept, in bytes (about 10 KB).
MAX_BODY_BYTES=10000

# Secret used to turn a user's chat ID into a private, unguessable ID (Layer 2).
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it safe. If you change it, every user gets a new ID and their history is lost.
ID_SECRET=

# Layer 3 limits. Each line is optional: delete it to use the default shown.
# Longest message the bot will answer, in characters.
MAX_MESSAGE_CHARS=500
# Most messages one person can send in any 60 seconds.
RATE_LIMIT_PER_MINUTE=5
# Most messages one person can send per day (Dhaka time).
USER_DAILY_LIMIT=50
# Most messages the whole shop will answer per day. This is your cost safety net.
GLOBAL_DAILY_LIMIT=2000

# Storage (optional). SQLite file by default; for PostgreSQL later, change only this line.
DATABASE_URL=sqlite:///data/support.db
# Message texts are erased after this many days. Time, outcome and counts stay.
RETENTION_DAYS=30
